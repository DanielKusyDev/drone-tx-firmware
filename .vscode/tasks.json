{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "PlatformIO Build",
			"command": "pio",
			"args": [
				"run"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$platformio"
			],
			"detail": "Build the project"
		},
		{
			"type": "shell",
			"label": "PlatformIO Upload",
			"command": "pio",
			"args": [
				"run",
				"--target",
				"upload"
			],
			"group": "build",
			"problemMatcher": [
				"$platformio"
			],
			"detail": "Upload firmware to ESP32-C3"
		},
		{
			"type": "shell",
			"label": "PlatformIO Monitor",
			"command": "pio",
			"args": [
				"device",
				"monitor"
			],
			"group": "build",
			"problemMatcher": [],
			"isBackground": true,
			"detail": "Start serial monitor"
		},
		{
			"type": "shell",
			"label": "PlatformIO Upload and Monitor",
			"command": "pio",
			"args": [
				"run",
				"--target",
				"upload",
				"--target",
				"monitor"
			],
			"group": "build",
			"problemMatcher": [
				"$platformio"
			],
			"detail": "Upload firmware and start serial monitor"
		},
		{
			"type": "shell",
			"label": "PlatformIO Clean",
			"command": "pio",
			"args": [
				"run",
				"--target",
				"clean"
			],
			"group": "build",
			"problemMatcher": [
				"$platformio"
			],
			"detail": "Clean build files"
		},
		{
			"label": "PlatformIO Build",
			"type": "shell",
			"command": "platformio",
			"args": [
				"run"
			],
			"problemMatcher": [
				"$platformio"
			],
			"group": "build"
		}
	]
}